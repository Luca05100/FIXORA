# =============================================
# AutoBook — Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================

# Database (SQLite for development, PostgreSQL for production)
# SQLite (local development):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production — Neon/Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/autobook?sslmode=require"

# NextAuth.js
# Generate a random secret: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret-in-production"
# Auth URL (set to your domain in production)
AUTH_URL="http://localhost:3000"

# Email (Resend)
# Get your API key at https://resend.com
# Leave empty for development (emails will be logged to console)
RESEND_API_KEY=""
# The "from" address for outgoing emails (must be verified in Resend)
EMAIL_FROM="noreply@autobook.ro"

# Cron Job Secret
# Used to protect the /api/cron/reminder endpoint
# Generate a random secret: openssl rand -base64 32
CRON_SECRET="change-me-to-a-random-cron-secret"

# Webhook (optional)
# URL to send webhook notifications to (WhatsApp, Telegram, etc.)
WEBHOOK_URL=""
# Secret for outgoing webhooks (sent as X-Webhook-Secret header)
WEBHOOK_SECRET=""

# Incoming Webhook Secret (optional)
# Secret for validating incoming webhooks at /api/webhook/notify
INCOMING_WEBHOOK_SECRET=""
